{
  "name": "weavecarbon-api",
  "version": "1.0.0",
  "description": "WeavCarbon API - Carbon tracking and sustainability management",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "node scripts/migrate.js && node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node scripts/migrate.js",
    "analytics:flush": "node scripts/flush-analytics-outbox.js",
    "build:release": "node scripts/build-release.js",
    "clean:local": "node scripts/clean-local.js",
    "check:syntax": "node scripts/check-syntax.js",
    "lint": "eslint .",
    "test": "jest",
    "verify": "npm run check:syntax && npm run lint",
    "verify:full": "npm run check:syntax && npm run lint && npm test",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "keywords": [
    "carbon",
    "sustainability",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3"
  },
  "overrides": {
    "minimatch": "^10.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DauDinhQuangAnh/BE_weavecarbon.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/DauDinhQuangAnh/BE_weavecarbon/issues"
  },
  "homepage": "https://github.com/DauDinhQuangAnh/BE_weavecarbon#readme"
}
