  ],
  "restrictions": [
    {
      "ruleId": "ANNEX_XVII_43_AZO_AMINES",
      "entryNumber": "43",
      "substanceGroup": "Azodyes releasing Appendix 8 aromatic amines",
      "threshold": { "operator": "above", "value": 30, "unit": "mg/kg" },
      "sourceId": "ECHA-ANNEX-XVII-ENTRY-43",
      "targetCategories": ["apparel", "footwear"],
      "scope": "Textile or leather articles, or dyed parts, that may come into direct and prolonged contact with human skin or the oral cavity.",
      "requiredScopeFacts": ["directAndProlongedSkinOrOralContact"],
      "requiredEvidenceTypes": ["azo_amine_test_report", "dyed_part_material_map", "appendix_8_substance_screen"]
    },
    {
      "ruleId": "ANNEX_XVII_46A_NPE",
      "entryNumber": "46a",
      "substanceGroup": "Nonylphenol ethoxylates (NPE)",
      "threshold": { "operator": "greater_than_or_equal", "value": 0.01, "unit": "percent_by_weight" },
      "sourceId": "ECHA-ANNEX-XVII-ENTRY-46A",
      "targetCategories": ["apparel"],
      "scope": "Textile articles or textile parts with at least 80% textile fibres that can reasonably be expected to be washed in water during their normal lifecycle.",
      "requiredScopeFacts": ["washableInWaterDuringNormalLifecycle", "secondHand", "exclusivelyRecycledWithoutNpe"],
      "requiredEvidenceTypes": ["npe_test_report", "washability_assessment", "textile_fibre_composition", "recycled_textile_process_declaration"]
    },
    {
      "ruleId": "ANNEX_XVII_47_CHROMIUM_VI_LEATHER",
      "entryNumber": "47",
      "substanceGroup": "Chromium VI compounds in leather",
      "threshold": { "operator": "greater_than_or_equal", "value": 3, "unit": "mg/kg_dry_leather" },
      "sourceId": "ECHA-ANNEX-XVII-ENTRY-47",
      "targetCategories": ["footwear"],
      "scope": "Leather articles or leather parts coming into contact with skin.",
      "requiredScopeFacts": ["leatherPartsContactSkin", "secondHand"],
      "requiredEvidenceTypes": ["chromium_vi_leather_test_report", "leather_part_map", "skin_contact_assessment"]
    }
  ],
  "explicitExclusions": [
    "Complete REACH Annex XVII coverage or a complete substance list",
